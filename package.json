{
  "name": "lumiere",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "LUMIÈRE — The Endless Gallery: an infinite procedurally generated art museum",
  "scripts": {
    "build:curated": "node tools/build-curated.mjs",
    "dev:curated": "node tools/build-curated.mjs --serve",
    "art:curated": "node tools/export-curated-art.mjs",
    "test:curated": "playwright test --config playwright.curated.config.js",
    "test:ci-scope": "node --test test/unit/ci-scope.test.js",
    "test:unit": "node --test test/unit/*.test.js test/unit/*.test.ts",
    "build:site": "npm run build && npm run build:curated && node tools/build-site.mjs",
    "typecheck": "tsc -p tsconfig.curated.json",
    "build": "node build.mjs --minify",
    "build:readable": "node build.mjs",
    "dev": "node build.mjs --watch",
    "archive": "node build.mjs --archive",
    "test": "node build.mjs --archive && playwright test",
    "test:fast": "playwright test -g \"boot|cloud layer\"",
    "verify:sql": "./tools/verify-sql.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
